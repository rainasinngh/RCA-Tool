# --- Environment ---
ENVIRONMENT=production

# --- Postgres (used by docker-compose to create the DB container) ---
POSTGRES_USER=rca
POSTGRES_PASSWORD=change-me
POSTGRES_DB=rcadb

# --- Database (used by the app) ---
# host is "postgres" when running via docker-compose, "localhost" when
# running the app directly against a docker-compose'd Postgres
DATABASE_URL=postgresql://rca:change-me@postgres:5432/rcadb

# --- Prometheus ---
PROMETHEUS_URL=http://prometheus:9090

# --- Window / correlation processing ---
# how long a window stays open waiting for more related alerts before closing
WINDOW_DEBOUNCE_MINUTES=10
# hard cap on how long one window can stay open, even under a continuous storm
WINDOW_MAX_DURATION_MINUTES=30
# how often (seconds) the worker checks for windows ready to process
WINDOW_POLL_INTERVAL_SECONDS=60

# --- Webhook auth ---
# generate with: openssl rand -hex 32
# configure Alertmanager's webhook_config to send this as the X-Webhook-Token header
WEBHOOK_TOKEN=change-me

# --- SMTP (used to email RCA reports) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-alerting-account@company.com
SMTP_PASSWORD=your-app-password
SMTP_USE_TLS=true

MAIL_FROM=your-alerting-account@company.com
# comma-separated list, no spaces needed
MAIL_TO=oncall@company.com,sre-team@company.com
